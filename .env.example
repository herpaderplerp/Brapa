# Copy to .env and fill in. Never commit .env.
POSTGRES_USER=brapa
POSTGRES_PASSWORD=brapa
POSTGRES_DB=brapa
DATABASE_URL=postgresql+asyncpg://brapa:brapa@db:5432/brapa

# Signing key for session cookies (generate: python -c "import secrets;print(secrets.token_urlsafe(48))")
SESSION_SECRET=change-me-dev-only

# OAuth providers (only google wired at launch). Leave blank to disable a provider.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Base URL used to build OAuth redirect URIs.
BASE_URL=http://localhost:8000

# Third-party services
OPEN_METEO_BASE=https://archive-api.open-meteo.com/v1/archive
NOMINATIM_BASE=https://nominatim.openstreetmap.org

# Local storage root (mounted volume in compose)
STORAGE_DIR=/app/var/uploads

# Comma-separated invite allowlist. Empty = open registration.
ALLOWED_EMAILS=
